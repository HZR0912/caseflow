# 复制为 .env 后使用；.env 不入库
POSTGRES_USER=caseflow
POSTGRES_PASSWORD=caseflow_dev_pw
POSTGRES_DB=caseflow
POSTGRES_PORT=5432

DATABASE_URL=postgresql://caseflow:caseflow_dev_pw@127.0.0.1:5432/caseflow

REDIS_URL=redis://127.0.0.1:6379/0

OPA_URL=http://127.0.0.1:8181

# JSON 数组：token_sha256 / user_id / role / tenant。默认无凭据，策略接口返回 401。
# 随机 token 的生成与配置见 README；此处不要填写真实原始 token。
AUTH_CREDENTIALS=[]

# W5 默认纯规则，零 API 调用；可配置 Qwen/DeepSeek 等兼容接口，按列表顺序超时降级。
MOCKCORP_URL=http://127.0.0.1:8001
PLANNING_PROVIDERS=[]
APPROVAL_TTL_HOURS=24
# W7 Fernet key: generate once, keep stable across restarts, never commit to Git.
# Empty = approval-only mode; new requests cannot be executed until configured and resubmitted.
EXECUTION_ENCRYPTION_KEY=
# 列表元素：name、base_url（到 /v1 或兼容根路径）、model、api_key、timeout_s。
# 例：[{"name":"qwen","base_url":"https://dashscope.aliyuncs.com/compatible-mode/v1","model":"qwen-plus","api_key":"..."}]
# 第二家可用 name=deepseek, base_url=https://api.deepseek.com, model=deepseek-chat。

# MockCorp（W2）：单独 profile 启动；故障注入默认关闭。
MOCKCORP_PORT=8001
MOCKCORP_FAULTS_ENABLED=false
MOCKCORP_FAULT_DELAY_S=1
MOCKCORP_INITIAL_BALANCE_CENTS=100000
MOCKCORP_CODE_SEAT_LIMIT=3
MOCKCORP_ALLOWED_EMAIL_DOMAINS=["example.com","mockcorp.test"]

# 模型层（W3 起使用；先留空）
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=

# W10: local durable replay and optional OTel/Langfuse export.
OBSERVATION_ENABLED=false
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
LANGFUSE_BASE_URL=http://127.0.0.1:13000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Optional PLANNING_PROVIDERS fields: input_usd_per_million / output_usd_per_million.
# Missing usage or prices is displayed as unknown, not free.
