# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 工具缓存
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# 本地配置与密钥（只提交 .env.example）
.env
.env.local

# 运行时产物
*.log
tmp/
data/*
# 例外：制度语料是知识库的源文件，必须入库。
# 注意 `data/` 会排除整个目录，git 不会进去找例外；必须排除 `data/*` 再放行子目录。
!data/policies/
*.sqlite3
.pgdata/

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
